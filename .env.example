# ==============================================================================
# PROFILE SWITCHER
# ==============================================================================
# Set to 'dev'   -> Uses your local MySQL (localhost:3306) -> 100% FREE, offline
# Set to 'cloud' -> Uses Aiven Cloud MySQL -> ONLY for Judge Demo
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# Aiven Cloud MySQL Credentials (Used when SPRING_PROFILES_ACTIVE=cloud)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://<AIVEN_HOST>:<AIVEN_PORT>/defaultdb?sslMode=REQUIRED&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_aiven_password_here

# ------------------------------------------------------------------------------
# Ollama AI Configuration
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
